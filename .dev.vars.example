# Local dev secrets. Copy to .dev.vars (git-ignored) before running `wrangler dev`.
# In production, set these via:
#   wrangler secret put GOOGLE_SERVICE_ACCOUNT_JSON
#   wrangler secret put MCP_BEARER_TOKEN

# Full JSON of the Service Account key file, on a single line.
GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"gsc-mcp@your-project.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}'

# Random opaque string. Generate with: openssl rand -hex 32
MCP_BEARER_TOKEN=replace-me-with-a-long-random-secret
